# Identity, connections and secrets (spec section 5). Copy to .env for local dev.
# Dynaconf reads these (envvar_prefix="RAG_MCP"). Every store/queue name MUST contain
# DOMAIN_ID or startup fails (isolation guard). Non-secret tuning lives in settings.toml.

# --- identity ---
RAG_MCP_DOMAIN_ID=hr

# --- postgres ---
# Port 5433 on the host: docker-compose.yaml publishes Postgres there so it does not
# collide with the orchestrator's own Postgres on 5432.
RAG_MCP_POSTGRES_URL=postgresql+asyncpg://hr:hr@localhost:5433/hr

# --- qdrant ---
RAG_MCP_QDRANT_URL=http://localhost:6333
RAG_MCP_QDRANT_API_KEY=
RAG_MCP_QDRANT_COLLECTION=hr-knowledge

# --- s3 / minio ---
RAG_MCP_S3_ENDPOINT=http://localhost:9000
RAG_MCP_S3_REGION=us-east-1
RAG_MCP_S3_BUCKET=hr-documents
RAG_MCP_S3_ACCESS_KEY=hr-mcp
RAG_MCP_S3_SECRET_KEY=hr-mcp-secret

# --- auth: store only SHA-256 hashes of the bearer tokens (never the tokens) ---
# generate: python -c "from app.session.auth import hash_token; print(hash_token('my-token'))"
RAG_MCP_CHAT_SERVICE_TOKEN_HASH=
RAG_MCP_OPS_SERVICE_TOKEN_HASH=

# --- embedding / rerank gateway ---
# Default provider is "openai" (settings.toml): OpenAI-shaped POST {URL}/embeddings and
# Cohere-shaped POST {URL}/rerank. For OpenRouter use https://openrouter.ai/api/v1 and an
# sk-or-... key; the local fake-embedding-api serves both shapes for offline dev.
# The lexical branch is BM25 computed in-process — it needs no service and no key.
RAG_MCP_EMBEDDING_API_URL=https://openrouter.ai/api/v1/
RAG_MCP_EMBEDDING_API_TOKEN=

# --- queue ---
RAG_MCP_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RAG_MCP_QUEUE_NAMESPACE=hr

# --- bind addresses for containers (override settings.toml) ---
RAG_MCP_MCP_HOST=0.0.0.0
RAG_MCP_OPS_HOST=0.0.0.0
